          "findRegex": "/<StatusPlaceHolderImpl\\s*\\/>/g",
          "replaceString": "<div data-xumi-wall=\"KEJIAN_WALL_V1\">\n<style>\n[data-xumi-wall]{--xm-blue:#1446d8;--xm-blue-deep:#0b2f9d;--xm-paper:#fffef8;--xm-paper-cool:#f5f8ff;--xm-lime:#caff38;--xm-coral:#ff5b50;--xm-ink:#111937;--xm-muted:#647099;display:block;width:100%;min-width:0;max-width:760px;margin:16px auto;color:var(--xm-ink);color-scheme:light;font-family:\"Microsoft YaHei\",\"PingFang SC\",sans-serif}\n[data-xumi-wall] *{box-sizing:border-box}\n[data-xumi-wall] .xm-sheet{position:relative;overflow:hidden;padding:19px 20px 18px;border:2px solid var(--xm-blue);border-radius:22px;background:linear-gradient(90deg,transparent 0 51px,rgba(255,91,80,.24) 52px 53px,transparent 54px),repeating-linear-gradient(180deg,transparent 0 31px,rgba(20,70,216,.10) 32px),linear-gradient(135deg,var(--xm-paper),var(--xm-paper-cool));box-shadow:0 12px 26px rgba(20,48,128,.13),inset 0 0 0 4px rgba(255,255,255,.7)}\n[data-xumi-wall] .xm-tape{position:absolute;width:78px;height:22px;top:-4px;left:50%;transform:translateX(-50%) rotate(-2deg);background:rgba(202,255,56,.78);box-shadow:0 2px 5px rgba(24,50,98,.12)}\n[data-xumi-wall] .xm-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:5px 0 13px 43px;border-bottom:2px solid var(--xm-blue)}\n[data-xumi-wall] .xm-brand{display:flex;align-items:center;gap:9px;min-width:0}\n[data-xumi-wall] .xm-mark{display:grid;width:36px;height:36px;place-items:center;border:2px solid var(--xm-blue);border-radius:50%;background:var(--xm-lime);font:900 17px/1 Arial,sans-serif;transform:rotate(-5deg)}\n[data-xumi-wall] .xm-title{font:900 19px/1.15 \"Microsoft YaHei\",\"PingFang SC\",sans-serif;letter-spacing:.08em;color:var(--xm-blue-deep)}\n[data-xumi-wall] .xm-subtitle{margin-top:3px;color:var(--xm-muted);font-size:11px;line-height:1.35}\n[data-xumi-wall] .xm-live{display:inline-flex;align-items:center;gap:6px;flex:0 0 auto;padding:6px 9px;border:1.5px solid var(--xm-blue);border-radius:999px;background:#fff;color:var(--xm-blue-deep);font-size:11px;font-weight:800;white-space:nowrap}\n[data-xumi-wall] .xm-live::before{content:\"\";width:7px;height:7px;border-radius:50%;background:var(--xm-coral);box-shadow:0 0 0 3px rgba(255,91,80,.16)}\n[data-xumi-wall] .xm-post{position:relative;margin:17px 0 0 31px;padding:18px 18px 16px;border:2px solid var(--xm-blue);border-radius:15px;background:rgba(255,255,255,.91);box-shadow:5px 5px 0 var(--xm-blue)}\n[data-xumi-wall] .xm-post-top{display:flex;align-items:center;justify-content:space-between;gap:10px}\n[data-xumi-wall] .xm-hot{display:inline-flex;align-items:center;padding:5px 8px;border:1.5px solid var(--xm-blue);border-radius:5px;background:var(--xm-lime);color:var(--xm-blue-deep);font-size:11px;font-weight:900;letter-spacing:.06em;transform:rotate(-1.5deg)}\n[data-xumi-wall] .xm-heat{color:var(--xm-blue-deep);font-size:12px;font-weight:800;white-space:nowrap}\n[data-xumi-wall] .xm-heat strong{font:900 22px/1 Arial,sans-serif;color:var(--xm-coral)}\n[data-xumi-wall] blockquote{margin:16px 0 9px;padding:0;border:0;color:#101a40;font:900 clamp(22px,4.3vw,34px)/1.38 \"Microsoft YaHei\",\"PingFang SC\",sans-serif;letter-spacing:-.02em}\n[data-xumi-wall] .xm-reason{margin:0;color:var(--xm-muted);font-size:13px;line-height:1.65}\n[data-xumi-wall] .xm-reason::before{content:\"“\";color:var(--xm-coral);font-size:19px;font-weight:900}\n[data-xumi-wall] .xm-reactions{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}\n[data-xumi-wall] .xm-chip{padding:5px 8px;border:1px solid rgba(20,70,216,.36);border-radius:999px;background:#fff;color:#364272;font-size:11px;font-weight:700}\n[data-xumi-wall] .xm-chip:nth-child(2){transform:rotate(1deg)}\n[data-xumi-wall] .xm-effect{display:flex;align-items:flex-start;gap:8px;margin-top:14px;padding:10px 11px;border-left:4px solid var(--xm-coral);background:rgba(255,91,80,.075);color:#313b68;font-size:12px;line-height:1.55}\n[data-xumi-wall] .xm-effect strong{flex:0 0 auto;color:var(--xm-coral)}\n[data-xumi-wall] .xm-reply{position:relative;margin:14px 0 0 44px;padding:12px 14px;border:1.5px solid var(--xm-blue);border-radius:4px 14px 14px 14px;background:#fff;color:#202b58}\n[data-xumi-wall] .xm-reply::before{content:\"\";position:absolute;left:-7px;top:-1.5px;width:12px;height:12px;border-top:1.5px solid var(--xm-blue);border-left:1.5px solid var(--xm-blue);background:#fff;transform:skewX(-28deg)}\n[data-xumi-wall] .xm-reply-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px}\n[data-xumi-wall] .xm-reply-author{color:var(--xm-blue-deep);font-size:11px;font-weight:900}\n[data-xumi-wall] .xm-admin-scribble{color:var(--xm-coral);font:800 12px/1 \"KaiTi\",\"STKaiti\",serif;transform:rotate(-5deg)}\n[data-xumi-wall] [hidden]{display:none!important}\n[data-xumi-wall] .xm-reply-text{font-size:13.5px;line-height:1.6}\n[data-xumi-wall] .xm-actions{margin:17px 0 0 31px}\n[data-xumi-wall] .xm-actions-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:9px}\n[data-xumi-wall] .xm-actions-title{color:var(--xm-blue-deep);font-size:12px;font-weight:900;letter-spacing:.08em}\n[data-xumi-wall] .xm-actions-note{color:var(--xm-muted);font-size:10px}\n[data-xumi-wall] .xm-action-list{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n[data-xumi-wall] button{min-width:0;min-height:47px;padding:10px 12px;border:1.5px solid var(--xm-blue);border-radius:11px;background:#fff;color:var(--xm-blue-deep);font:700 12.5px/1.55 \"Microsoft YaHei\",\"PingFang SC\",sans-serif;cursor:pointer;text-align:left;transition:transform .15s ease,box-shadow .15s ease,background .15s ease}\n[data-xumi-wall] .xm-action-list>button:first-child{grid-column:1/-1;min-height:54px;border-width:2px;background:var(--xm-lime);box-shadow:4px 4px 0 var(--xm-blue);font-size:14px;font-weight:900}\n[data-xumi-wall] button:hover{transform:translateY(-1px);box-shadow:3px 3px 0 rgba(20,70,216,.8)}\n[data-xumi-wall] button:focus-visible{outline:3px solid rgba(255,91,80,.62);outline-offset:2px}\n[data-xumi-wall] button:disabled{cursor:wait;opacity:.62;transform:none;box-shadow:none}\n[data-xumi-wall] .xm-compose{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;margin-top:10px}\n[data-xumi-wall] .xm-compose input{width:100%;min-width:0;height:43px;border:1.5px solid var(--xm-blue);border-radius:11px;padding:0 12px;background:rgba(255,255,255,.94);color:var(--xm-ink);font:700 12.5px/1 \"Microsoft YaHei\",\"PingFang SC\",sans-serif;outline:none}\n[data-xumi-wall] .xm-compose input::placeholder{color:#8992ad;font-weight:500}\n[data-xumi-wall] .xm-compose input:focus{box-shadow:0 0 0 3px rgba(255,91,80,.25);border-color:var(--xm-coral)}\n[data-xumi-wall] .xm-compose button{min-height:43px;padding:8px 15px;background:var(--xm-blue);color:#fff;text-align:center;font-weight:900}\n[data-xumi-wall] .xm-receipt{min-height:18px;margin:10px 0 0;color:var(--xm-muted);font-size:11px;line-height:1.55}\n[data-xumi-wall][data-status=\"active\"] .xm-hot{background:var(--xm-coral);color:#fff}\n[data-xumi-wall][data-status=\"expired\"] .xm-hot{background:#e5e9f5;color:#59627f}\n@media(max-width:620px){[data-xumi-wall]{margin:10px auto}[data-xumi-wall] .xm-sheet{padding:15px 13px 14px;border-radius:17px;background:linear-gradient(90deg,transparent 0 29px,rgba(255,91,80,.20) 30px 31px,transparent 32px),repeating-linear-gradient(180deg,transparent 0 31px,rgba(20,70,216,.10) 32px),linear-gradient(135deg,var(--xm-paper),var(--xm-paper-cool))}[data-xumi-wall] .xm-head{padding-left:22px;align-items:flex-start}[data-xumi-wall] .xm-live{padding:5px 7px}[data-xumi-wall] .xm-post,[data-xumi-wall] .xm-actions{margin-left:17px}[data-xumi-wall] .xm-post{padding:15px 13px 13px;box-shadow:3px 3px 0 var(--xm-blue)}[data-xumi-wall] blockquote{font-size:23px}[data-xumi-wall] .xm-reply{margin-left:28px}[data-xumi-wall] .xm-action-list{grid-template-columns:1fr}[data-xumi-wall] .xm-action-list>button:first-child{grid-column:auto}[data-xumi-wall] .xm-actions-note{display:none}[data-xumi-wall] .xm-compose{grid-template-columns:1fr}[data-xumi-wall] .xm-compose button{width:100%}}\n</style>\n<section class=\"xm-sheet\" aria-label=\"课间墙当前热门帖\">\n  <span class=\"xm-tape\" aria-hidden=\"true\"></span>\n  <header class=\"xm-head\">\n    <div class=\"xm-brand\"><span class=\"xm-mark\" aria-hidden=\"true\">墙</span><div><div class=\"xm-title\">课间墙</div><div class=\"xm-subtitle\"><span data-xm-period>第二节课间</span> · <span data-xm-location>高三（三）班教室</span></div></div></div>\n    <span class=\"xm-live\" data-xm-live>投票中</span>\n  </header>\n  <article class=\"xm-post\">\n    <div class=\"xm-post-top\"><span class=\"xm-hot\" data-xm-hot-label>今日最热</span><span class=\"xm-heat\"><strong data-xm-heat>23</strong> 人想看</span></div>\n    <blockquote data-xm-post>下一节课，所有人只能说真话。</blockquote>\n    <p class=\"xm-reason\" data-xm-reason>想看一节课的真实世界长什么样。</p>\n    <div class=\"xm-reactions\" aria-label=\"同学们的反应\"><span class=\"xm-chip\">笑死</span><span class=\"xm-chip\">刺激</span><span class=\"xm-chip\">求别来啊</span></div>\n    <div class=\"xm-effect\"><strong data-xm-countdown>还差 1 票</strong><span><span data-xm-next>下节数学课</span> · <span data-xm-effect>尚未生效</span></span></div>\n  </article>\n  <aside class=\"xm-reply\"><div class=\"xm-reply-head\"><span class=\"xm-reply-author\" data-xm-reply-author>坐我旁边的同学</span><span class=\"xm-admin-scribble\" data-xm-admin hidden>管理员</span></div><div class=\"xm-reply-text\" data-xm-reply>你最好别投赞成。</div></aside>\n  <section class=\"xm-actions\">\n    <div class=\"xm-actions-head\"><span class=\"xm-actions-title\">现在，你要怎么做？</span><span class=\"xm-actions-note\">也可以在输入框里自己说</span></div>\n    <div class=\"xm-action-list\" data-xm-actions></div>\n    <form class=\"xm-compose\" data-xm-compose><input data-xm-input type=\"text\" maxlength=\"180\" autocomplete=\"off\" placeholder=\"匿名回复……\" aria-label=\"匿名回复\"><button type=\"submit\">发出</button></form>\n    <div class=\"xm-receipt\" data-xm-receipt>点一下就会把这句话原样说出去。</div>\n  </section>\n</section>\n<script>\n(() => {\n  const root = document.querySelector('[data-xumi-wall]');\n  if (!root) return;\n  const text = (value, fallback) => typeof value === 'string' && value.trim() ? value.trim() : fallback;\n  const number = (value, fallback = 0) => Number.isFinite(Number(value)) ? Number(value) : fallback;\n  const cleanActions = value => Array.isArray(value)\n    ? [...new Set(value.map(item => typeof item === 'string' ? item.trim() : '').filter(Boolean))].slice(0, 3)\n    : [];\n  const statusCopy = {\n    voting: { live: '投票中', hot: '今日最热' },\n    active: { live: '正在成真', hot: '本节生效' },\n    expired: { live: '本轮结束', hot: '已经发生' },\n  };\n  const submit = async text => {\n    const receipt = root.querySelector('[data-xm-receipt]');\n    const buttons = Array.from(root.querySelectorAll('button'));\n    const input = root.querySelector('[data-xm-input]');\n    buttons.forEach(button => { button.disabled = true; button.setAttribute('aria-busy', 'true'); });\n    input.disabled = true;\n    receipt.textContent = '已选择：“' + text + '”';\n    try {\n      await SillyTavern.app.chat.sendMessage(text);\n      receipt.textContent = '消息已经发出，等许弥接话。';\n    } catch (error) {\n      receipt.textContent = '刚才没能发出去，请再点一次或改用输入框。';\n      buttons.forEach(button => { button.disabled = false; button.removeAttribute('aria-busy'); });\n      input.disabled = false;\n    }\n  };\n  const render = () => {\n    const state = Mvu.getMvuData().stat_data || {};\n    const scene = state.scene || {};\n    const wall = state.wall || {};\n    const turnView = state.turn_view || {};\n    const flags = state.flags || {};\n    const status = ['voting', 'active', 'expired'].includes(wall.status) ? wall.status : 'voting';\n    const copy = statusCopy[status];\n    root.dataset.status = status;\n    root.querySelector('[data-xm-period]').textContent = text(scene.period, '课间');\n    root.querySelector('[data-xm-location]').textContent = text(scene.location, '教室');\n    root.querySelector('[data-xm-live]').textContent = copy.live;\n    root.querySelector('[data-xm-hot-label]').textContent = copy.hot;\n    root.querySelector('[data-xm-heat]').textContent = String(Math.max(0, Math.round(number(wall.heat))));\n    root.querySelector('[data-xm-post]').textContent = text(wall.hot_post, '暂时没有热门帖。');\n    root.querySelector('[data-xm-reason]').textContent = text(wall.reason, '没有人写理由。');\n    const needed = Math.max(0, Math.round(number(wall.votes_needed)));\n    root.querySelector('[data-xm-countdown]').textContent = status === 'voting' ? (needed === 0 ? '票数已满' : '还差 ' + needed + ' 票') : (status === 'active' ? '已经成真' : '效果已结束');\n    root.querySelector('[data-xm-next]').textContent = status === 'active' ? text(scene.next_class, '本节课') : '下节' + text(scene.next_class, '课');\n    root.querySelector('[data-xm-effect]').textContent = text(wall.effect, '尚未生效');\n    root.querySelector('[data-xm-reply-author]').textContent = text(wall.latest_reply_author, '匿名同学');\n    root.querySelector('[data-xm-reply]').textContent = text(wall.latest_reply, '……');\n    root.querySelector('[data-xm-admin]').hidden = flags.knows_admin !== true;\n    const actionsNode = root.querySelector('[data-xm-actions]');\n    actionsNode.replaceChildren();\n    const actions = cleanActions(turnView.next_actions);\n    if (actions.length === 0) {\n      const empty = document.createElement('div');\n      empty.className = 'xm-reason';\n      empty.textContent = '没有现成选项，直接在输入框里说也可以。';\n      actionsNode.appendChild(empty);\n      return;\n    }\n    actions.forEach(text => {\n      const button = document.createElement('button');\n      button.type = 'button';\n      button.textContent = text;\n      button.addEventListener('click', () => submit(text));\n      actionsNode.appendChild(button);\n    });\n  };\n  root.querySelector('[data-xm-compose]').addEventListener('submit', event => {\n    event.preventDefault();\n    const input = root.querySelector('[data-xm-input]');\n    const draft = input.value;\n    if (!draft.trim()) {\n      root.querySelector('[data-xm-receipt]').textContent = '先写一句再发。';\n      input.focus();\n      return;\n    }\n    submit(draft);\n  });\n  eventOn(Mvu.events.VARIABLE_UPDATE_ENDED, render);\n  render();\n})();\n</script>\n</div>",
