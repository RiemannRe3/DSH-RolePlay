        {
          "id": "sunianzhi-status-panel-v2",
          "scriptName": "念念状态与下一步行动",
          "findRegex": "/<StatusPlaceHolderImpl\\s*\\/>/g",
          "replaceString": "<div data-niannian-panel=\"NIANNIAN_PANEL_V2\">\n<style>\n[data-niannian-panel]{--paper:#fffaf0;--ink:#3d352f;--muted:#7c7066;--line:#e4d3c0;--rose:#a75462;--rose-soft:#f5dfe1;--green:#557765;display:grid;max-width:720px;margin:14px auto;gap:10px;color:var(--ink);font-family:system-ui,-apple-system,\"Segoe UI\",\"Microsoft YaHei\",sans-serif}\n[data-niannian-panel] *{box-sizing:border-box}\n[data-niannian-panel] .nn-card{padding:16px 18px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,#fffdf8,var(--paper));box-shadow:0 12px 30px rgba(75,51,38,.10)}\n[data-niannian-panel] .nn-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n[data-niannian-panel] .nn-kicker{font-size:10px;font-weight:800;letter-spacing:.14em;color:var(--rose)}\n[data-niannian-panel] h3{margin:4px 0 0;font:750 17px/1.25 Georgia,\"Noto Serif SC\",serif}\n[data-niannian-panel] .nn-phase{padding:6px 9px;border-radius:999px;background:var(--rose-soft);color:#783f49;font-size:11px;font-weight:750;white-space:nowrap}\n[data-niannian-panel] .nn-grid{display:grid;grid-template-columns:minmax(150px,.72fr) minmax(0,1.55fr);gap:8px;margin-top:13px}\n[data-niannian-panel] .nn-cell{padding:12px;border:1px solid #eadfd3;border-radius:12px;background:rgba(255,255,255,.68)}\n[data-niannian-panel] .nn-cell small{display:block;color:var(--muted);font-size:10px}\n[data-niannian-panel] .nn-score{display:flex;align-items:baseline;gap:4px;margin-top:4px}\n[data-niannian-panel] .nn-score b{font-size:24px;line-height:1}\n[data-niannian-panel] .nn-score span{color:var(--muted);font-size:11px}\n[data-niannian-panel] .nn-track{height:6px;overflow:hidden;margin-top:10px;border-radius:99px;background:#eadfd3}\n[data-niannian-panel] .nn-track i{display:block;height:100%;width:0;border-radius:inherit;background:var(--green);transition:width .2s ease}\n[data-niannian-panel] blockquote{margin:7px 0 0;color:#614c46;font:600 13px/1.65 Georgia,\"Noto Serif SC\",serif}\n[data-niannian-panel] .nn-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:11px}\n[data-niannian-panel] button{min-height:46px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:#fff;color:var(--ink);font:inherit;font-size:12px;cursor:pointer;text-align:left}\n[data-niannian-panel] button:hover{border-color:var(--rose);background:#fffdfb}\n[data-niannian-panel] button:disabled{cursor:wait;opacity:.55}\n[data-niannian-panel] .nn-receipt{min-height:16px;margin-top:9px;color:var(--muted);font-size:10px;line-height:1.5}\n[data-niannian-panel] .nn-empty{grid-column:1/-1;padding:10px;border:1px dashed var(--line);border-radius:10px;color:var(--muted);font-size:11px}\n@media(max-width:560px){[data-niannian-panel] .nn-grid,[data-niannian-panel] .nn-actions{grid-template-columns:1fr}}\n</style>\n<section class=\"nn-card\" data-nn-status>\n  <div class=\"nn-head\"><div><div class=\"nn-kicker\">念念 / 当前状态</div><h3>念念 · <span data-nn-location>银杏道</span></h3></div><span class=\"nn-phase\" data-nn-phase>初次接触</span></div>\n  <div class=\"nn-grid\">\n    <div class=\"nn-cell\"><small>好感度</small><div class=\"nn-score\"><b data-nn-favorability>8</b><span>/ 100</span></div><div class=\"nn-track\"><i data-nn-favorability-track></i></div></div>\n    <div class=\"nn-cell\"><small>念念的内心 OS</small><blockquote data-nn-inner-os>小抄怎么偏偏这时候露出来了……</blockquote></div>\n  </div>\n</section>\n<section class=\"nn-card\" data-nn-actions-card>\n  <div class=\"nn-head\"><div><div class=\"nn-kicker\">NEXT MOVE</div><h3>下一步行动</h3></div><span class=\"nn-phase\">每轮更新</span></div>\n  <div class=\"nn-actions\" data-nn-actions></div>\n  <div class=\"nn-receipt\" data-nn-receipt>点一下，就把这句话直接说出来。</div>\n</section>\n<script>\n(() => {\n  const root = document.querySelector('[data-niannian-panel]');\n  if (!root) return;\n  const clamp = value => Math.max(0, Math.min(100, Number(value) || 0));\n  const labels = {\n    phase: {task_contact:'初次接触',script_break:'剧本失灵',violation_exposed:'违规暴露',alliance:'联手欺骗',decision:'告白／反抗'}\n  };\n  const actionStrings = value => Array.isArray(value)\n    ? [...new Set(value.map(item => typeof item === 'string' ? item.trim() : '').filter(Boolean))].slice(0, 2)\n    : [];\n  const submit = async text => {\n    const receipt = root.querySelector('[data-nn-receipt]');\n    const buttons = Array.from(root.querySelectorAll('button'));\n    buttons.forEach(button => { button.disabled = true; });\n    receipt.textContent = '已选择：“' + text + '”。';\n    try {\n      await SillyTavern.app.chat.sendMessage(text);\n      receipt.textContent = '已发送，等念念回应。';\n    } catch (error) {\n      receipt.textContent = '暂时没能发送，请改用输入框重试。';\n      buttons.forEach(button => { button.disabled = false; });\n    }\n  };\n  const render = () => {\n    const state = Mvu.getMvuData().stat_data || {};\n    const story = state.story || {};\n    const relation = state.relation || {};\n    const turnView = state.turn_view || {};\n    const favorability = clamp(relation.favorability);\n    root.querySelector('[data-nn-phase]').textContent = labels.phase[story.phase] || '状态待确认';\n    root.querySelector('[data-nn-location]').textContent = typeof story.location === 'string' && story.location.trim() ? story.location.trim() : '地点待确认';\n    root.querySelector('[data-nn-favorability]').textContent = String(favorability);\n    root.querySelector('[data-nn-favorability-track]').style.width = favorability + '%';\n    root.querySelector('[data-nn-inner-os]').textContent = typeof turnView.inner_os === 'string' && turnView.inner_os.trim() ? turnView.inner_os.trim() : '……';\n    const actionsNode = root.querySelector('[data-nn-actions]');\n    actionsNode.replaceChildren();\n    const actions = actionStrings(turnView.next_actions);\n    if (actions.length === 0) {\n      const empty = document.createElement('div');\n      empty.className = 'nn-empty';\n      empty.textContent = '这一步没有现成选项，可以直接在输入框里继续。';\n      actionsNode.appendChild(empty);\n      return;\n    }\n    actions.forEach(text => {\n      const button = document.createElement('button');\n      button.type = 'button';\n      button.textContent = text;\n      button.addEventListener('click', () => submit(text));\n      actionsNode.appendChild(button);\n    });\n  };\n  eventOn(Mvu.events.VARIABLE_UPDATE_ENDED, render);\n  render();\n})();\n</script>\n</div>",
