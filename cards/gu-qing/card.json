    "extensions": {
      "talkativeness": "0.65",
      "fav": false,
      "depth_prompt": {
        "prompt": "优先记住已经确认的证据及其依据、仍待验证的假设、已排除项、剩余案期、当前程序风险和顾清对玩家办案方法的判断。固定真相不能随玩家猜测改变。",
        "depth": 4,
        "role": "system"
      },
      "regex_scripts": [
        {
          "id": "guqing-hide-update-v1",
          "scriptName": "隐藏案卷更新",
          "findRegex": "/<UpdateVariable\\b[\\s\\S]*?<\\/UpdateVariable>/gi",
          "replaceString": "",
          "placement": [
            2
          ],
          "disabled": false,
          "markdownOnly": true,
          "promptOnly": true,
          "runOnEdit": true,
          "substituteRegex": 0,
          "minDepth": null,
          "maxDepth": null
        },
        {
          "id": "guqing-dossier-panel-v2",
          "scriptName": "顾清案牍与查案行动",
          "findRegex": "/<StatusPlaceHolderImpl\\s*\\/>/g",
          "replaceString": "<div data-guqing-panel=\"GUQING_DOSSIER_V2\">\n<style>\n[data-guqing-panel]{--paper:#f3e7cf;--paper-light:#fbf5e8;--paper-deep:#dfc79c;--ink:#30281f;--muted:#665744;--line:rgba(112,82,48,.3);--line-soft:rgba(112,82,48,.16);--seal:#8a3028;--seal-deep:#68221d;display:grid;width:100%;min-width:0;max-width:760px;margin:16px auto;gap:12px;color:var(--ink);color-scheme:light;font-family:\"Microsoft YaHei\",\"PingFang SC\",sans-serif}\n[data-guqing-panel] *{box-sizing:border-box}\n[data-guqing-panel] .gq-paper{padding:20px 22px 18px;border:1px solid #a98a5e;border-radius:4px;background:linear-gradient(105deg,rgba(153,111,57,.06),transparent 18%,transparent 82%,rgba(153,111,57,.05)),linear-gradient(180deg,var(--paper-light),var(--paper));box-shadow:inset 0 0 0 3px rgba(255,250,238,.52),0 8px 18px rgba(40,29,16,.12)}\n[data-guqing-panel] .gq-head{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:13px;padding:1px 0 15px;border-bottom:1px solid var(--line)}\n[data-guqing-panel] .gq-seal{display:grid;width:42px;height:42px;place-items:center;border:2px solid var(--seal);box-shadow:inset 0 0 0 1px rgba(138,48,40,.35);color:var(--seal);font:700 20px/1 \"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",STSong,SimSun,serif}\n[data-guqing-panel] .gq-kicker{font:600 12px/1.4 \"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",STSong,SimSun,serif;letter-spacing:.22em;color:var(--seal)}\n[data-guqing-panel] h3{margin:3px 0 0;font:700 20px/1.35 \"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",STSong,SimSun,serif;letter-spacing:.05em}\n[data-guqing-panel] .gq-meta{margin-top:4px;color:var(--muted);font:400 12px/1.45 \"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",STSong,SimSun,serif}\n[data-guqing-panel] .gq-deadline{padding:7px 10px;border:1px solid var(--seal);border-radius:3px;background:rgba(138,48,40,.035);color:var(--seal-deep);font:600 12px/1.35 \"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",STSong,SimSun,serif;letter-spacing:.08em;white-space:nowrap}\n[data-guqing-panel] .gq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:3px}\n[data-guqing-panel] .gq-cell{min-width:0;padding:15px 14px;border-bottom:1px solid var(--line-soft);background:transparent}\n[data-guqing-panel] .gq-wide{grid-column:1/-1}\n[data-guqing-panel] .gq-split{border-right:1px solid var(--line-soft)}\n[data-guqing-panel] .gq-tail{border-bottom:0}\n[data-guqing-panel] .gq-label{display:block;margin-bottom:9px;color:var(--seal-deep);font:600 12px/1.4 \"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",STSong,SimSun,serif;letter-spacing:.08em}\n[data-guqing-panel] ul{display:grid;gap:9px;margin:0;padding-left:18px;list-style:disc}\n[data-guqing-panel] li{padding-left:2px;font-size:13.5px;line-height:1.65}\n[data-guqing-panel] li::marker{color:var(--seal)}\n[data-guqing-panel] li+li{padding-top:8px;border-top:1px dashed var(--line-soft)}\n[data-guqing-panel] li small{display:block;margin-top:3px;color:var(--muted);font-size:12px;line-height:1.55}\n[data-guqing-panel] .gq-empty{color:var(--muted);font-size:12px;list-style:none}\n[data-guqing-panel] .gq-risk{margin:0;font-size:13.5px;line-height:1.7}\n[data-guqing-panel] .gq-assessment{display:inline-block;padding:4px 0 3px;border-bottom:1px solid var(--seal);color:#49392c;font:600 13.5px/1.45 \"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",STSong,SimSun,serif}\n[data-guqing-panel] .gq-action-head{display:flex;align-items:end;justify-content:space-between;gap:12px;padding-bottom:12px;border-bottom:1px solid var(--line)}\n[data-guqing-panel] .gq-actions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:13px}\n[data-guqing-panel] button{min-height:48px;padding:11px 13px;border:1px solid rgba(112,82,48,.36);border-left:3px solid var(--seal);border-radius:3px;background:rgba(255,250,239,.58);color:var(--ink);font:400 13.5px/1.65 \"Microsoft YaHei\",\"PingFang SC\",sans-serif;cursor:pointer;text-align:left;transition:transform .15s ease,border-color .15s ease,background .15s ease}\n[data-guqing-panel] button:hover{border-color:var(--seal);background:rgba(255,250,239,.92);transform:translateY(-1px)}\n[data-guqing-panel] button:focus-visible{outline:2px solid var(--seal);outline-offset:2px}\n[data-guqing-panel] button:disabled{cursor:wait;opacity:.68;transform:none}\n[data-guqing-panel] .gq-receipt{min-height:18px;margin-top:10px;color:var(--muted);font-size:12px;line-height:1.6}\n@media(max-width:620px){[data-guqing-panel]{margin:10px auto;gap:10px}[data-guqing-panel] .gq-paper{padding:14px}[data-guqing-panel] .gq-head{grid-template-columns:auto minmax(0,1fr);align-items:start}[data-guqing-panel] .gq-deadline{grid-column:1/-1;justify-self:start;margin-top:1px}[data-guqing-panel] h3{font-size:19px}[data-guqing-panel] .gq-grid{grid-template-columns:1fr}[data-guqing-panel] .gq-wide{grid-column:auto}[data-guqing-panel] .gq-split{border-right:0}[data-guqing-panel] .gq-tail{border-bottom:1px solid var(--line-soft)}[data-guqing-panel] .gq-cell:last-child{border-bottom:0}}\n</style>\n<section class=\"gq-paper\">\n  <div class=\"gq-head\"><span class=\"gq-seal\" aria-hidden=\"true\">寺</span><div><div class=\"gq-kicker\">大理寺案牍</div><h3>西市浮尸案</h3><div class=\"gq-meta\">顾清录 · <span data-gq-location>长安义庄</span></div></div><span class=\"gq-deadline\" data-gq-deadline>剩余时日 · 七日</span></div>\n  <div class=\"gq-grid\">\n    <section class=\"gq-cell gq-wide\"><span class=\"gq-label\">已确认事实</span><ul data-gq-confirmed></ul></section>\n    <section class=\"gq-cell gq-split\"><span class=\"gq-label\">待验线索</span><ul data-gq-pending></ul></section>\n    <section class=\"gq-cell\"><span class=\"gq-label\">已排除项</span><ul data-gq-excluded></ul></section>\n    <section class=\"gq-cell gq-split gq-tail\"><span class=\"gq-label\">程序风险</span><p class=\"gq-risk\" data-gq-risk>京兆府催促并案；大理寺只有七日补足证据</p></section>\n    <section class=\"gq-cell gq-tail\"><span class=\"gq-label\">顾清对你的判断</span><span class=\"gq-assessment\" data-gq-assessment>待验</span></section>\n  </div>\n</section>\n<section class=\"gq-paper\">\n  <div class=\"gq-action-head\"><div><div class=\"gq-kicker\">眼下可做</div><h3>从哪一处继续查</h3></div></div>\n  <div class=\"gq-actions\" data-gq-actions></div>\n  <div class=\"gq-receipt\" data-gq-receipt>上列只是眼下可行的查法；你也可以在下方直接写下自己的验尸、查证或问讯行动。</div>\n</section>\n<script>\n(() => {\n  const root = document.querySelector('[data-guqing-panel]');\n  if (!root) return;\n  const dayNames = ['零','一','二','三','四','五','六','七'];\n  const cleanActions = value => Array.isArray(value)\n    ? [...new Set(value.map(item => typeof item === 'string' ? item.trim() : '').filter(Boolean))].slice(0, 3)\n    : [];\n  const evidenceItems = (value, status) => Object.values(value && typeof value === 'object' ? value : {})\n    .filter(item => item && item.status === status && typeof item.statement === 'string' && item.statement.trim());\n  const renderEvidence = (node, items) => {\n    node.replaceChildren();\n    if (items.length === 0) {\n      const empty = document.createElement('li');\n      empty.className = 'gq-empty';\n      empty.textContent = '暂无';\n      node.appendChild(empty);\n      return;\n    }\n    items.forEach(item => {\n      const row = document.createElement('li');\n      row.textContent = item.statement.trim();\n      if (typeof item.basis === 'string' && item.basis.trim()) {\n        const basis = document.createElement('small');\n        basis.textContent = '依据：' + item.basis.trim();\n        row.appendChild(basis);\n      }\n      node.appendChild(row);\n    });\n  };\n  const submit = async text => {\n    const receipt = root.querySelector('[data-gq-receipt]');\n    const buttons = Array.from(root.querySelectorAll('button'));\n    buttons.forEach(button => { button.disabled = true; });\n    receipt.textContent = '已选择：“' + text + '”。';\n    try {\n      await SillyTavern.app.chat.sendMessage(text);\n      receipt.textContent = '已送入案中，等顾清回应。';\n    } catch (error) {\n      receipt.textContent = '暂时没能送出，请改用输入框重试。';\n      buttons.forEach(button => { button.disabled = false; });\n    }\n  };\n  const render = () => {\n    const state = Mvu.getMvuData().stat_data || {};\n    const caseState = state.case || {};\n    const evidence = state.evidence || {};\n    const procedure = state.procedure || {};\n    const relationship = state.relationship || {};\n    const turnView = state.turn_view || {};\n    const remaining = Math.max(0, Math.min(7, Number(caseState.days_remaining) || 0));\n    root.querySelector('[data-gq-location]').textContent = typeof caseState.location === 'string' && caseState.location.trim() ? caseState.location.trim() : '地点待确认';\n    root.querySelector('[data-gq-deadline]').textContent = '剩余时日 · ' + (dayNames[remaining] || String(remaining)) + '日';\n    renderEvidence(root.querySelector('[data-gq-confirmed]'), evidenceItems(evidence, 'confirmed'));\n    renderEvidence(root.querySelector('[data-gq-pending]'), evidenceItems(evidence, 'pending'));\n    renderEvidence(root.querySelector('[data-gq-excluded]'), evidenceItems(evidence, 'excluded'));\n    root.querySelector('[data-gq-risk]').textContent = typeof procedure.risk === 'string' && procedure.risk.trim() ? procedure.risk.trim() : '暂无明确风险';\n    root.querySelector('[data-gq-assessment]').textContent = typeof relationship.assessment === 'string' && relationship.assessment.trim() ? relationship.assessment.trim() : '待验';\n    const actionsNode = root.querySelector('[data-gq-actions]');\n    actionsNode.replaceChildren();\n    const actions = cleanActions(turnView.next_actions);\n    if (actions.length === 0) {\n      const empty = document.createElement('div');\n      empty.className = 'gq-empty';\n      empty.textContent = '没有现成建议，可以直接写下自己的行动。';\n      actionsNode.appendChild(empty);\n      return;\n    }\n    actions.forEach(text => {\n      const button = document.createElement('button');\n      button.type = 'button';\n      button.textContent = text;\n      button.addEventListener('click', () => submit(text));\n      actionsNode.appendChild(button);\n    });\n  };\n  eventOn(Mvu.events.VARIABLE_UPDATE_ENDED, render);\n  render();\n})();\n</script>\n</div>",
